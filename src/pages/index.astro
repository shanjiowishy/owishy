---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import profile from '../data/profile.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
---
<PortfolioLayout title={`${profile.name} — Public Health Researcher`} description={profile.about}>
  <SiteHeader />
  <main id="main" class="cv-page">
    <header class="cv-intro" id="about">
      <div class="cv-intro-copy">
        <h1>{profile.name}</h1>
        <p class="cv-role">Public Health Researcher | Environmental Epidemiology | Mixed-Methods Research</p>
        <p class="cv-contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={`mailto:${profile.secondaryEmail}`}>{profile.secondaryEmail}</a>
          <span>{profile.phone}</span>
          <span>{profile.location}</span>
          <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </p>
        <p class="cv-summary">{profile.about}</p>
        <a class="cv-download" href={`${base}Shanjida-Farzana-Owishy-CV.pdf`} download>Download CV</a>
      </div>
      <figure class="profile-photo"><img src={`${base}images/shanjida-farzana-owishy.png`} alt="Shanjida Farzana Owishy" width="300" height="319" /></figure>
    </header>

    <section class="cv-section" id="interests" data-reveal>
      <h2>Research Interests</h2>
      <ul class="interest-plain">{profile.researchInterests.map((interest) => <li>{interest}</li>)}</ul>
    </section>

    <section class="cv-section" id="research" data-reveal>
      <h2>Selected Research</h2>
      <div class="cv-list">{profile.research.map((item) => <article><h3>{item.title}</h3><p class="cv-meta">{item.funder}</p><p>{item.description}</p></article>)}</div>
    </section>

    <section class="cv-section" id="experience" data-reveal>
      <h2>Research and Work Experience</h2>
      <div class="cv-list experience-list">{profile.experience.map((item) => <article><div class="cv-entry-heading"><div><h3>{item.role}</h3><p class="cv-meta">{item.organization}</p></div><time>{item.period}</time></div><p>{item.description}</p><ul>{item.details.map((detail) => <li>{detail}</li>)}</ul></article>)}</div>
    </section>

    <section class="cv-section" id="education" data-reveal>
      <h2>Education</h2>
      <div class="cv-list education-list">{profile.education.map((item) => <article><div class="cv-entry-heading"><div><h3>{item.degree}</h3><p class="cv-meta">{item.school}</p></div><time>{item.period}</time></div><p>{item.grade} · {item.award}</p><p><strong>Thesis:</strong> {item.thesis}</p><p><strong>Relevant coursework:</strong> {item.coursework}</p></article>)}</div>
    </section>

    <section class="cv-section" id="methods" data-reveal>
      <h2>Research Skills</h2>
      <div class="definition-list">{profile.skills.map((skill) => <div><h3>{skill.label}</h3><p>{skill.items}</p></div>)}</div>
    </section>

    <section class="cv-section" id="publications" data-reveal>
      <h2>Publications and Conference Papers</h2>
      <div class="publication-group"><h3>Under Review</h3><div class="cv-list">{profile.publications.map((item) => <article><h3>{item.title}</h3><p class="cv-meta">{item.status}</p></article>)}</div></div>
      <div class="publication-group"><h3>Conference Papers</h3><div class="cv-list">{profile.conferences.map((item) => <article><h3>{item.title}</h3><p>{item.venue}</p></article>)}</div></div>
    </section>

    <section class="cv-section two-column" data-reveal>
      <div><h2>Awards</h2><ul>{profile.awards.map((award) => <li>{award}</li>)}</ul></div>
      <div><h2>Leadership and Volunteering</h2><ul>{profile.leadership.map((item) => <li>{item}</li>)}</ul></div>
    </section>

    <section class="cv-section" id="writing" data-reveal>
      <div class="cv-section-heading"><h2>Blog</h2><a href={`${base}blog/`}>View all posts</a></div>
      <div class="writing-list">{posts.map((post) => <article><time>{post.data.publishedDate.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' })}</time><div><h3><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></div></article>)}</div>
    </section>
  </main>
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>{profile.email}</span></footer>
</PortfolioLayout>
