---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
---
<PortfolioLayout title="Page not found · Shanjida Farzana Owishy" description="The requested page could not be found.">
  <main class="not-found"><p class="eyebrow">404 · Page not found</p><h1>This research trail ends here.</h1><p>The page you were looking for does not exist or has moved.</p><a class="button button-primary" href={import.meta.env.BASE_URL}>Return home</a></main>
</PortfolioLayout>
<style>.not-found{min-height:100vh;display:grid;place-content:center;justify-items:start;gap:1.4rem;padding:3rem;background:#eaf7ff}.not-found h1{font:400 clamp(3.5rem,8vw,7rem)/.95 'Newsreader',serif;max-width:850px;margin:0}.not-found p{max-width:520px}</style>
