---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import PostCard from '../../components/PostCard.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
---
<PortfolioLayout title="Blog · Shanjida Farzana Owishy" description="Articles about public health and research by Shanjida Farzana Owishy.">
  <SiteHeader />
  <main id="main"><header class="blog-hero"><p class="eyebrow">Shanjida Farzana Owishy</p><h1>Blog</h1><p>Articles about public health, qualitative research, fieldwork and research methods.</p></header><section class="section" aria-labelledby="articles-title"><div class="section-heading"><h2 id="articles-title">Articles</h2><a class="text-link" href={`${base}rss.xml`}>RSS feed</a></div><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></section></main>
  <footer><span>© {new Date().getFullYear()} Shanjida Farzana Owishy</span><a href={base}>Portfolio</a></footer>
</PortfolioLayout>
