---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="header-marker" data-header-marker aria-hidden="true"></div>
<header class="site-header">
  <a class="researcher-name" href={base} aria-label="Shanjida Farzana Owishy, home"><span>Shanjida Farzana</span> Owishy</a>
  <nav id="primary-navigation" aria-label="Primary navigation" data-mobile-menu><a href={`${base}#interests`}>Interests</a><a href={`${base}#research`}>Research</a><a href={`${base}#publications`}>Publications</a><a href={`${base}#methods`}>Methods</a><a href={`${base}blog/`}>Writing</a></nav>
  <div class="header-actions">
    <button class="menu-toggle" type="button" data-menu-toggle aria-label="Open navigation menu" aria-controls="primary-navigation" aria-expanded="false"><span></span><span></span><span></span></button>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color mode" aria-pressed="false"><span class="sun" aria-hidden="true">L</span><span class="moon" aria-hidden="true">D</span></button>
  </div>
</header>
