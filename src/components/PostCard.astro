---
interface Props { post: any; }
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const date = post.data.publishedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<article class="post-card" data-reveal>
  <a class="post-card-link" href={`${base}blog/${post.id}/`}>
    <div class="post-card-art" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="post-card-copy"><div class="post-meta"><time datetime={post.data.publishedDate.toISOString()}>{date}</time><span>{post.data.tags[0] ?? 'Research notes'}</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-more">Read article <span aria-hidden="true">→</span></span></div>
  </a>
</article>
